{
	"name": "n8n-nodes-fred",
	"version": "0.0.3",
	"description": "n8n community node for FRED® (Federal Reserve Economic Data) API v2",
	"license": "MIT",
	"homepage": "https://fred.stlouisfed.org/docs/api/fred/v2/index.html",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"fred",
		"federal-reserve",
		"economic-data",
		"st-louis-fed"
	],
	"author": {
		"name": "Jon Aldekoa",
		"email": "jaldekoa@gmail.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FredApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Fred/Fred.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
